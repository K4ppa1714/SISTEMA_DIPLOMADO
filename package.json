{
  "name": "operaguas-analitica",
  "version": "1.0.0",
  "private": true,
  "description": "Operaguas Analítica: Next.js (app/) + FastAPI (api/) en un solo proyecto de Vercel.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "api:dev": "python3 -m uvicorn api.index:app --reload --port 8000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types app/_lib/*.test.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.0"
  }
}
